"use client";

import { useEffect, useState } from "react";
import {
  ArrowUpRight,
  BookOpen,
  Check,
  CheckCircle2,
  Sparkles,
} from "lucide-react";

export type Feedback = Record<string, unknown> | string;

/* ------------------------------------------------------------------ */
/* Config                                                              */
/* ------------------------------------------------------------------ */

const SCORE_CATEGORIES = [
  {
    key: "technical_understanding",
    reasonKeys: ["technical_reason", "technical_understanding_reason"],
    label: "Technical understanding",
    description: "Understanding of concepts and implementation",
  },
  {
    key: "code_understanding",
    reasonKeys: ["code_reason", "code_understanding_reason"],
    label: "Code understanding",
    description: "Code flow, structure, and behavior",
  },
  {
    key: "problem_solving",
    reasonKeys: ["problem_solving_reason"],
    label: "Problem solving",
    description: "Debugging and approaching challenges",
  },
  {
    key: "engineering_reasoning",
    reasonKeys: ["engineering_reasoning_reason"],
    label: "Engineering reasoning",
    description: "Trade-offs, maintainability, and design decisions",
  },
  {
    key: "depth",
    reasonKeys: ["depth_reason"],
    label: "Technical depth",
    description: "How deeply you explored implementation details",
  },
] as const;

const HANDLED_KEYS = new Set<string>([
  "overall_score",
  "strengths",
  "areas_to_improve",
  "topics_to_review",
  "final_assessment",
  ...SCORE_CATEGORIES.flatMap((c) => [c.key, ...c.reasonKeys]),
]);

/* ------------------------------------------------------------------ */
/* Helpers                                                             */
/* ------------------------------------------------------------------ */

function formatLabel(value: string) {
  return value
    .replace(/_/g, " ")
    .replace(/\b\w/g, (letter) => letter.toUpperCase());
}

/** Lower-case keys so SCORE vs score from the backend both work. */
function normalize(report: Record<string, unknown>) {
  return Object.fromEntries(
    Object.entries(report).map(([key, value]) => [key.toLowerCase(), value]),
  );
}

function toText(value: unknown): string {
  if (value == null) return "";
  if (typeof value === "string") return value.trim();
  if (typeof value === "number") return String(value);
  if (Array.isArray(value)) return value.map(toText).filter(Boolean).join("\n");
  return JSON.stringify(value, null, 2);
}

/** Accepts 8, "8", "8/10", "8.5 / 10". Returns 0-10 or null. */
function toScore(value: unknown): number | null {
  if (value == null || value === "") return null;

  let n: number;
  if (typeof value === "number") {
    n = value;
  } else {
    const match = String(value).match(/-?\d+(\.\d+)?/);
    if (!match) return null;
    n = parseFloat(match[0]);
  }

  return Number.isFinite(n) ? Math.max(0, Math.min(10, n)) : null;
}

/** Turns an array or a bulleted / numbered / newline-separated string into items. */
function toList(value: unknown): string[] {
  if (value == null) return [];

  if (Array.isArray(value)) {
    return value.map(toText).filter(Boolean);
  }

  return toText(value)
    .split(/\r?\n/)
    .map((line) => line.replace(/^\s*(?:[-*•]|\d+[.)])\s*/, "").trim())
    .filter(Boolean);
}

function toTopics(value: unknown): string[] {
  const list = toList(value);
  if (list.length === 1 && list[0].includes(",")) {
    return list[0]
      .split(",")
      .map((item) => item.trim())
      .filter(Boolean);
  }
  return list;
}

function firstText(report: Record<string, unknown>, keys: readonly string[]) {
  for (const key of keys) {
    const text = toText(report[key]);
    if (text) return text;
  }
  return "";
}

function formatScore(score: number) {
  return Number.isInteger(score) ? String(score) : score.toFixed(1);
}

function tone(score: number) {
  if (score >= 8)
    return { text: "text-emerald-300", bar: "bg-emerald-400", ring: "border-emerald-400/60" };
  if (score >= 6)
    return { text: "text-violet-300", bar: "bg-violet-400", ring: "border-violet-400/60" };
  return { text: "text-amber-300", bar: "bg-amber-400", ring: "border-amber-400/60" };
}

function scoreLabel(score: number) {
  if (score >= 9) return "Excellent";
  if (score >= 8) return "Strong";
  if (score >= 6) return "Good foundation";
  if (score >= 4) return "Needs improvement";
  return "Needs more practice";
}

/* ------------------------------------------------------------------ */
/* Pieces                                                              */
/* ------------------------------------------------------------------ */

function ScoreBar({ score, ready }: { score: number; ready: boolean }) {
  return (
    <div
      role="progressbar"
      aria-valuemin={0}
      aria-valuemax={10}
      aria-valuenow={score}
      className="h-1.5 overflow-hidden rounded-full bg-white/[0.07]"
    >
      <div
        className={`h-full rounded-full transition-[width] duration-1000 ease-out motion-reduce:transition-none ${tone(score).bar}`}
        style={{ width: ready ? `${score * 10}%` : "0%" }}
      />
    </div>
  );
}

function ListCard({
  title,
  description,
  items,
  icon,
  accent,
}: {
  title: string;
  description: string;
  items: string[];
  icon: React.ReactNode;
  accent: string;
}) {
  return (
    <article className="rounded-xl border border-white/[0.08] bg-[#111114] p-5 sm:p-6">
      <div className="flex items-start gap-3">
        <div
          className={`flex h-9 w-9 shrink-0 items-center justify-center rounded-xl ${accent}`}
        >
          {icon}
        </div>
        <div className="min-w-0">
          <h4 className="text-sm font-semibold text-white">{title}</h4>
          <p className="mt-1 text-xs text-zinc-500">{description}</p>
        </div>
      </div>

      <ul className="mt-4 space-y-3 border-t border-white/[0.06] pt-4">
        {items.map((item, index) => (
          <li
            key={index}
            className="flex gap-3 text-sm leading-6 text-zinc-300"
          >
            <span
              aria-hidden
              className="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-zinc-600"
            />
            <span className="min-w-0 break-words">{item}</span>
          </li>
        ))}
      </ul>
    </article>
  );
}

/* ------------------------------------------------------------------ */
/* Report                                                              */
/* ------------------------------------------------------------------ */

export function FeedbackReport({ feedback }: { feedback: Feedback }) {
  const [ready, setReady] = useState(false);

  /* Lets the score bars animate from 0 on mount. */
  useEffect(() => {
    const id = requestAnimationFrame(() => setReady(true));
    return () => cancelAnimationFrame(id);
  }, []);

  if (typeof feedback === "string" || feedback === null) {
    return (
      <section className="rounded-xl border border-white/[0.08] bg-white/[0.025] p-5">
        <h3 className="mb-3 text-sm font-semibold text-white">
          Final feedback
        </h3>
        <p className="whitespace-pre-wrap break-words text-sm leading-7 text-zinc-300">
          {toText(feedback)}
        </p>
      </section>
    );
  }

  const report = normalize(feedback);

  const overall = toScore(report.overall_score);
  const strengths = toList(report.strengths);
  const improvements = toList(report.areas_to_improve);
  const topics = toTopics(report.topics_to_review);
  const assessment = toText(report.final_assessment);

  const extras = Object.entries(report).filter(
    ([key, value]) => !HANDLED_KEYS.has(key) && toText(value) !== "",
  );

  return (
    <div className="space-y-5">
      {/* Overall */}
      <section className="relative overflow-hidden rounded-2xl border border-violet-400/20 bg-gradient-to-br from-violet-500/[0.14] via-[#15121f] to-[#101014] p-5 sm:p-7">
        <div
          aria-hidden
          className="pointer-events-none absolute -right-12 -top-16 h-48 w-48 rounded-full bg-violet-500/10 blur-3xl"
        />

        <div className="relative flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <div className="inline-flex items-center gap-2 rounded-full border border-violet-300/20 bg-violet-400/[0.08] px-3 py-1.5 text-xs font-medium text-violet-200">
              <CheckCircle2 className="h-3.5 w-3.5" />
              Interview completed
            </div>

            <h3 className="mt-4 text-xl font-semibold tracking-tight text-white sm:text-2xl">
              Your interview report
            </h3>

            <p className="mt-2 max-w-md text-sm leading-6 text-zinc-400">
              Review your performance, understand your strengths, and
              identify what to improve next.
            </p>
          </div>

          {overall !== null && (
            <div className="flex shrink-0 items-center gap-4 rounded-xl border border-white/[0.09] bg-black/20 p-4 sm:min-w-[185px]">
              <div
                className={`flex h-[76px] w-[76px] items-center justify-center rounded-full border-[5px] ${tone(overall).ring}`}
              >
                <div className="text-center">
                  <div className="text-2xl font-bold tracking-tight text-white">
                    {formatScore(overall)}
                  </div>
                  <div className="text-[10px] text-zinc-500">/ 10</div>
                </div>
              </div>

              <div>
                <p className="text-xs text-zinc-500">Overall score</p>
                <p className={`mt-1 text-sm font-semibold ${tone(overall).text}`}>
                  {scoreLabel(overall)}
                </p>
              </div>
            </div>
          )}
        </div>
      </section>

      {/* Breakdown */}
      <section>
        <div className="mb-3 flex items-end justify-between gap-3">
          <div>
            <h3 className="text-base font-semibold text-white">
              Performance breakdown
            </h3>
            <p className="mt-1 text-xs text-zinc-500">
              Your results across five engineering skills
            </p>
          </div>
          <span className="hidden text-xs text-zinc-600 sm:block">
            Scores out of 10
          </span>
        </div>

        <div className="grid gap-3 sm:grid-cols-2">
          {SCORE_CATEGORIES.map((item, index) => {
            const score = toScore(report[item.key]);
            const reason = firstText(report, item.reasonKeys);

            if (score === null && !reason) return null;

            return (
              <article
                key={item.key}
                className="rounded-xl border border-white/[0.08] bg-white/[0.025] p-4 transition-colors duration-200 hover:border-violet-400/25 hover:bg-white/[0.04] sm:p-5 sm:[&:last-child:nth-child(odd)]:col-span-2"
              >
                <div className="flex items-start justify-between gap-3">
                  <div className="flex min-w-0 gap-3">
                    <div className="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/[0.07] bg-white/[0.035] text-xs font-semibold text-zinc-400">
                      0{index + 1}
                    </div>
                    <div>
                      <h4 className="text-sm font-semibold leading-5 text-zinc-100">
                        {item.label}
                      </h4>
                      <p className="mt-1 text-xs leading-5 text-zinc-500">
                        {item.description}
                      </p>
                    </div>
                  </div>

                  {score !== null && (
                    <div className="shrink-0 text-right">
                      <span
                        className={`text-2xl font-semibold tabular-nums ${tone(score).text}`}
                      >
                        {formatScore(score)}
                      </span>
                      <span className="text-xs text-zinc-600"> / 10</span>
                    </div>
                  )}
                </div>

                {score !== null && (
                  <div className="mt-4">
                    <ScoreBar score={score} ready={ready} />
                  </div>
                )}

                {reason && (
                  <p className="mt-4 whitespace-pre-wrap break-words border-t border-white/[0.06] pt-3 text-xs leading-6 text-zinc-400">
                    {reason}
                  </p>
                )}
              </article>
            );
          })}
        </div>
      </section>

      {/* Strengths / improvements */}
      {(strengths.length > 0 || improvements.length > 0) && (
        <section className="grid gap-3 md:grid-cols-2">
          {strengths.length > 0 && (
            <ListCard
              title="Your strengths"
              description="What you demonstrated well"
              items={strengths}
              icon={<Check className="h-4 w-4" />}
              accent="bg-emerald-500/10 text-emerald-300"
            />
          )}
          {improvements.length > 0 && (
            <ListCard
              title="Areas to improve"
              description="Where you can level up"
              items={improvements}
              icon={<ArrowUpRight className="h-4 w-4" />}
              accent="bg-amber-500/10 text-amber-300"
            />
          )}
        </section>
      )}

      {/* Topics */}
      {topics.length > 0 && (
        <section className="rounded-xl border border-white/[0.08] bg-[#111114] p-5 sm:p-6">
          <div className="flex items-start gap-3">
            <div className="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-sky-500/10 text-sky-300">
              <BookOpen className="h-4 w-4" />
            </div>
            <div>
              <h4 className="text-sm font-semibold text-white">
                Topics to review
              </h4>
              <p className="mt-1 text-xs text-zinc-500">
                What to study before your next interview
              </p>
            </div>
          </div>

          <ul className="mt-4 flex flex-wrap gap-2 border-t border-white/[0.06] pt-4">
            {topics.map((topic, index) => (
              <li
                key={index}
                className="rounded-md border border-white/[0.08] bg-white/[0.03] px-3 py-1.5 text-xs text-zinc-300"
              >
                {topic}
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* Final assessment */}
      {assessment && (
        <section className="relative overflow-hidden rounded-2xl border border-violet-400/20 bg-gradient-to-br from-violet-500/[0.1] via-[#15121e] to-[#101014] p-5 sm:p-7">
          <div className="flex items-center gap-3">
            <div className="flex h-10 w-10 items-center justify-center rounded-xl border border-violet-400/20 bg-violet-400/10">
              <Sparkles className="h-5 w-5 text-violet-300" />
            </div>
            <div>
              <h4 className="text-base font-semibold text-white">
                Final assessment
              </h4>
              <p className="mt-1 text-xs text-zinc-400">
                Your overall interview evaluation
              </p>
            </div>
          </div>

          <p className="mt-5 whitespace-pre-wrap break-words text-sm leading-7 text-zinc-300 sm:text-[15px]">
            {assessment}
          </p>
        </section>
      )}

      {/* Anything else the backend returns */}
      {extras.length > 0 && (
        <section className="grid gap-3 sm:grid-cols-2">
          {extras.map(([key, value]) => (
            <article
              key={key}
              className="rounded-xl border border-white/[0.08] bg-white/[0.025] p-5"
            >
              <h4 className="text-xs font-semibold uppercase tracking-wider text-zinc-500">
                {formatLabel(key)}
              </h4>
              <p className="mt-3 whitespace-pre-wrap break-words text-sm leading-7 text-zinc-300">
                {toText(value)}
              </p>
            </article>
          ))}
        </section>
      )}
    </div>
  );
}